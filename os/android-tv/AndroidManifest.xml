<?xml version="1.0" encoding="utf-8"?>
<!-- BlidOS: lets this Android run as an Android TV. TV system screens have no lock screen to draw
     the phone keyguard on, so Android starts without its keyguard service (BlidOS profiles have
     their own PINs). Installed on the product partition through Waydroid's overlay. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.blidos.overlay.tv">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />
    <overlay android:targetPackage="android" android:isStatic="true" android:priority="900" />
    <application android:hasCode="false" />
</manifest>
