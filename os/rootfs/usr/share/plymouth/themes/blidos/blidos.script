# BlidOS boot screen: the logo on the BlidOS background, gently pulsing while the system starts.
Window.SetBackgroundTopColor(0.086, 0.125, 0.227);
Window.SetBackgroundBottomColor(0.020, 0.027, 0.051);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);

name.image = Image.Text("BlidOS", 1, 1, 1, 1, "Sans Bold 28");
name.sprite = Sprite(name.image);
name.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - name.image.GetWidth() / 2);
name.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 32);

tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.75 + 0.25 * Math.Sin(tick / 12));
}
Plymouth.SetRefreshFunction(refresh_callback);
